generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  sku              String         @unique
  name             String
  slug             String         @unique
  brand            String?
  category         Category?      @relation(fields: [categoryId], references: [id])
  categoryId       String?
  description      String?        @db.Text
  shortDescription String?        @db.Text
  price            Float
  mrp              Float
  discount         Float?         @default(0)
  stockStatus      String         @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK
  stockQuantity    Int            @default(0)
  rating           Float          @default(0)
  reviewCount      Int            @default(0)
  popularity       Int            @default(0)
  featured         Boolean        @default(false)
  trending         Boolean        @default(false)
  bestSeller       Boolean        @default(false)
  images           ProductImage[]
  tags             String[]
  specifications   Json?
  ingredients      String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  wishlistItems    WishlistItem[]
  offerProducts    OfferProduct[]
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?         @db.Text
  image          String?
  active         Boolean         @default(true)
  sortOrder      Int             @default(0)
  products       Product[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  offerCategories OfferCategory[]
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String?        @unique // For logged in users if any, or link to cookie/session
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
}

model Offer {
  id            String          @id @default(cuid())
  title         String
  description   String?
  couponCode    String?         @unique
  discountType  String          @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue Float
  startDate     DateTime?
  endDate       DateTime?
  active        Boolean         @default(true)
  bannerImage   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  products      OfferProduct[]
  categories    OfferCategory[]
}

model OfferProduct {
  id        String  @id @default(cuid())
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([offerId, productId])
}

model OfferCategory {
  id         String   @id @default(cuid())
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId    String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@unique([offerId, categoryId])
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  inquiryType String
  message     String   @db.Text
  source      String?
  status      String   @default("NEW") // NEW, CONTACTED, CONVERTED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  content   String   @db.Text
  rating    Int      @default(5)
  image     String?
  verified  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transformation {
  id             String   @id @default(cuid())
  title          String
  customerName   String
  story          String   @db.Text
  beforeImage    String
  afterImage     String
  duration       String?
  productsUsed   String[]
  goal           String?
  result         String?
  verified       Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  details   Json?
  createdAt DateTime @default(now())
}
